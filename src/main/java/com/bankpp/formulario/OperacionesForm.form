          </grid>
        </constraints>
        <properties />
      </component>
      <component id="c8" class="javax.swing.JButton" binding="btnRetirar" default-binding="true">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>
          <text value="Retirar" />

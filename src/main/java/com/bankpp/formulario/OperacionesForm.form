          </grid>
        </constraints>
        <properties />
      </component>
      <component id="c4" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>
          <text value="Cuenta destino:" />
        </properties>
      </component>
      <component id="c5" class="javax.swing.JTextField" binding="txtCuentaDestino" default-binding="true">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties />
      </component>
      <component id="c6" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>

<?xml version="1.0" encoding="utf-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.bankpp.formulario.OperacionesForm">
  <grid id="rootGrid" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
    <margin top="16" left="16" bottom="16" right="16" />
    <constraints>
      <xy x="0" y="0" width="760" height="520" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="c1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>
          <text value="Operaciones Form" />
        </properties>
      </component>
      <component id="c2" class="javax.swing.JLabel">

<?xml version="1.0" encoding="utf-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.bankpp.formulario.HistorialForm">
  <grid id="rootGrid" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
    <margin top="16" left="16" bottom="16" right="16" />
    <constraints>
      <xy x="0" y="0" width="760" height="520" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="c1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>
          <text value="Historial Form" />
        </properties>
      </component>
      <component id="c2" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>
          <text value="Cuenta:" />
        </properties>
      </component>
      <component id="c3" class="javax.swing.JComboBox" binding="cmbCuenta" default-binding="true">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties />
      </component>
      <component id="c4" class="javax.swing.JTable" binding="tblMovimientos" default-binding="true">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties />
      </component>
      <component id="c5" class="javax.swing.JButton" binding="btnActualizar" default-binding="true">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
          </grid>
        </constraints>
        <properties>
          <text value="Actualizar movimientos" />
        </properties>
      </component>
    </children>
    <component id="c6" class="javax.swing.JLabel" binding="lblEstado" default-binding="true">
      <constraints>
        <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false" />
      </constraints>
      <properties>
        <text value=" " />
      </properties>
    </component>
  </grid>
</form>